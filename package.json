{
  "name": "library-secret-scanner",
  "version": "1.0.0",
  "description": "Azure DevOps extension for scanning library variable groups to identify unsecured secrets",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Adam Wheater",
  "repository": {
    "type": "git",
    "url": "https://github.com/adam-wheater/azure-devops-library-secret-scanner.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "screenshots": "webpack --config demo/webpack.config.js && node demo/shots.js",
    "postbuild": "node scripts/verify-bundle.js && node scripts/third-party-notices.js",
    "verify:bundle": "node scripts/verify-bundle.js",
    "package": "tfx extension create --manifest-globs vss-extension.json --output-path out",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "publish:marketplace": "tfx extension publish --manifest-globs vss-extension.json"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.234.0",
    "azure-devops-extension-sdk": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "ajv": "^8.18.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "mini-css-extract-plugin": "^2.10.1",
    "prettier": "^3.8.1",
    "tfx-cli": "^0.23.1",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
